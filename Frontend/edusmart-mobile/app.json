{
  "expo": {
    "name": "EduSmart",
    "slug": "edusmart-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "edusmart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "com.edusmart.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.edusmart.mobile"
    }
  }
}
